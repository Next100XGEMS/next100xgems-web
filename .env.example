# Browser-safe Supabase project URL. Safe to expose to client bundles.
NEXT_PUBLIC_SUPABASE_URL=

# Browser-safe Supabase publishable key. Safe to expose; it is not a permission grant.
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# Server-only Supabase URL for privileged server infrastructure.
SUPABASE_URL=

# Server-only Supabase secret key. Never expose to browser code or commit a real value.
SUPABASE_SECRET_KEY=

# Development-only Radar provider acceptance sandbox. Keep all values server-only.
HELIUS_API_KEY=
BIRDEYE_API_KEY=
GMGN_API_KEY=
COINGECKO_API_KEY=
SOLANA_RPC_URL=
EVM_RPC_URL=
ALCHEMY_API_KEY=
